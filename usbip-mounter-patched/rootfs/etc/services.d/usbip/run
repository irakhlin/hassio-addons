#!/command/with-contenv bashio
# ==============================================================================
# Home Assistant Add-on: USBIP Mounter
# Start the usbipd daemon service
# ==============================================================================

# Wait for usbipd to become available
s6-svwait -u -t 5000 /run/service/usbipd

bashio::log.info "Attaching usbip devices and monitoring for disconnects"

## mount_devices now attaches once and then loops forever, re-attaching any
## device that drops off - exec it directly so s6 supervises the loop itself
exec /usr/local/bin/mount_devices
